#!/usr/bin/env bash
# Opt-in operational step. Packaging does not run this script.
set -euo pipefail
if [[ $# != 1 || ! "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
 printf 'Usage: provision-technician <existing-non-root-unix-user>\n' >&2
 exit 2
fi
technician="$1"
if ! technician_uid="$(id -u -- "$technician")" || [[ "$technician_uid" == 0 ]]; then
 printf 'An existing non-root technician account is required.\n' >&2
 exit 2
fi
if [[ "$(id -un -- "$technician_uid")" != "$technician" ]]; then
 printf 'Canonical account name does not match.\n' >&2
 exit 2
fi
if [[ "$EUID" != 0 ]]; then
 printf 'Provisioning needs administrator authorization on the selected host.\n' >&2
 exit 2
fi
systemctl enable --now "infradesktopd@${technician}.service"
