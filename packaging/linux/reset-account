#!/usr/bin/python3
"""One-time root proof for a local account reset; no account secrets enter this helper."""
import os
import pwd
import re
import stat
import sys

NAME = re.compile(r'[a-z_][a-z0-9_-]{0,31}\Z')
NONCE = re.compile(r'[0-9a-f]{64}\Z')


def main():
    if len(sys.argv) != 3 or not NAME.fullmatch(sys.argv[1]) or not NONCE.fullmatch(sys.argv[2]):
        raise SystemExit('Invalid request.')
    uid_text = os.environ.get('PKEXEC_UID', '')
    if not re.fullmatch(r'[1-9][0-9]{0,9}', uid_text) or os.geteuid() != 0:
        raise SystemExit('Administrative authorization required.')
    uid = int(uid_text)
    if uid > 4294967295:
        raise SystemExit('Administrative authorization required.')
    try:
        user = pwd.getpwuid(uid)
        if user.pw_uid == 0 or user.pw_name != sys.argv[1]:
            raise ValueError('identity mismatch')
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
        runfd = os.open('/run', flags)
        try:
            runinfo = os.fstat(runfd)
            if runinfo.st_uid != 0 or stat.S_IMODE(runinfo.st_mode) & 0o022:
                raise ValueError('unsafe run directory')
            runtime = os.open('infradesktop-' + user.pw_name, flags, dir_fd=runfd)
            try:
                info = os.fstat(runtime)
                if info.st_uid != uid or stat.S_IMODE(info.st_mode) != 0o700:
                    raise ValueError('unsafe runtime')
                name = 'reset-' + sys.argv[2]
                fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=runtime)
                try:
                    data = sys.argv[2].encode('ascii')
                    while data:
                        count = os.write(fd, data)
                        if count <= 0:
                            raise OSError('short write')
                        data = data[count:]
                    os.fchown(fd, 0, 0)
                    os.fchmod(fd, 0o644)
                    os.fsync(fd)
                finally:
                    os.close(fd)
            finally:
                os.close(runtime)
        finally:
            os.close(runfd)
    except (KeyError, ValueError, OSError, OverflowError):
        raise SystemExit('Reset authorization failed.')


if __name__ == '__main__':
    main()
